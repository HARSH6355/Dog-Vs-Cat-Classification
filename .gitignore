# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
.pytest_cache/
.mypy_cache/

# Virtual environments
.venv/
venv/
env/
ENV/

# Jupyter Notebooks
.ipynb_checkpoints/

# Data (tracked by DVC instead)
data/raw/
data/processed/
!data/.gitignore

# Models (large binaries tracked by DVC — except best_model.pt for CI/Docker)
models/*.pt
models/*.h5
models/*.pkl
models/*.pth
!models/.gitkeep
!models/best_model.pt

# MLflow artifacts
mlruns/

# OS
.DS_Store
Thumbs.db
*.swp

# IDE
.vscode/
.idea/
*.iml

# Kaggle credentials (keep secret)
*.json
kaggle.json
# Allow the monitoring report to be committed
!monitoring/performance_report.json

# Temp
*.tmp
*.log
assignment_content.txt
